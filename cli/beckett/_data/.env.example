# Beckett — optional keys for loop runtime (copy to [base]/.env or [role]/.env as needed)
# Never commit real values.

# Roles parent (same as Pirandello masks). Used when you pass a bare role name to beckett.
# MASKS_BASE=

# Optional: model selection for Pydantic AI-backed agents.
# BECKETT_MODEL=
# Provider keys (examples):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional loop interval override (e.g. 15m, 5m, 30s, 1h).
# BECKETT_LOOP_INTERVAL=15m

# Optional dev override: use repo authoring tree instead of bundled _data/
# BECKETT_ROOT=
