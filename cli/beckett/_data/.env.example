# Beckett — optional keys for cron / heartbeat (copy to [base]/.env or [role]/.env as needed)
# Never commit real values.

# Roles parent (same as Pirandello masks). Used when you pass a bare role name to beckett.
# MASKS_BASE=

# Optional: full shell command for heartbeat LLM (default: claude --print --output-format text).
# BECKETT_LLM_CMD=
# BECKETT_LLM_DEBUG=1   # capture LLM stderr into .ooda.log

# Migration from Pirandello: MASKS_LLM_CMD / MASKS_LLM_DEBUG are still honored if BECKETT_* unset.

# Optional dev override: use repo authoring tree instead of bundled _data/
# BECKETT_ROOT=
